# Copy to .env. Never commit .env. Keys come from the shared vault, not chat.

# ---- shared ----
INTERNAL_TOKEN=change-me-to-a-long-random-string
EPISODE_DEFAULT_DAYS=10
TURN_TIMEOUT_SEC=180
GATE_TIMEOUT_SEC=8
ESCALATION_TIMEOUT_SEC=90
FP_PENALTY_RATE=0.02
APPROVAL_THRESHOLD=5000
DAY_PAUSE_SEC=0
LOG_LEVEL=info

# ---- battlefield ----
DATABASE_URL=postgresql://redledger:redledger@postgres:5432/redledger
CORS_ORIGINS=http://localhost:3000
POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_IMAGE=timescale/timescaledb:latest-pg16   # Tiger Data prize; optional

# ---- agents (Factory Droid SDK) ----
FACTORY_API_KEY=
DROID_MODEL_RED=
DROID_MODEL_GREEN=
DROID_MODEL_BLUE=
DRY_RUN=false

# ---- blue gate LLM (direct API, fast path) ----
BLUE_GATE_LLM_PROVIDER=gemini
BLUE_GATE_LLM_API_KEY=
BLUE_GATE_LLM_MODEL=

# ---- optional sponsor integrations ----
CRS_API_KEY=
CARTESIA_API_KEY=

# ---- frontend ----
NEXT_PUBLIC_BATTLEFIELD_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MOCK=false
