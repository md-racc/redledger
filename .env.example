# Copy to .env. Never commit .env. Keys come from the shared vault, not chat.
# Prod never uses this file directly: deploy/render-env.sh writes /opt/redledger/.env on the VM
# from the GitHub `production` environment on every deploy. Nobody edits the VM's .env by hand.

# ---- tokens (battlefield rejects a token used for the wrong caller; contracts/agent-service.md) ----
# Locally: any DIFFERENT strings. Prod: `openssl rand -hex 32` each, stored as secrets in
# the GitHub `production` environment.
# AGENT_TOKEN: shared agent token (any request with X-Agent; battlefield -> agent calls). Each agent
# falls back to it when its own AGENT_TOKEN_<AGENT> below is blank (battlefield warns: separation off).
AGENT_TOKEN=change-me-agent
# Per-agent tokens: battlefield holds all three, each agent container gets only its own (as its
# AGENT_TOKEN), so no agent can claim another's X-Agent. Set all three or none.
AGENT_TOKEN_RED=
AGENT_TOKEN_GREEN=
AGENT_TOKEN_BLUE=
# OPERATOR_TOKEN: control plane, /api/fe/*, /api/events, WS tickets. Held by battlefield, the
# frontend *server* (never a NEXT_PUBLIC_ var), the Makefile, and you.
OPERATOR_TOKEN=change-me

# ---- shared ----
EPISODE_DEFAULT_DAYS=10
TURN_TIMEOUT_SEC=180
GATE_TIMEOUT_SEC=8
ESCALATION_TIMEOUT_SEC=90
FP_PENALTY_RATE=0.02
APPROVAL_THRESHOLD=5000
DAY_PAUSE_SEC=0
LOG_LEVEL=info

# ---- battlefield ----
DATABASE_URL=postgresql://redledger:redledger@postgres:5432/redledger
CORS_ORIGINS=http://localhost:3000
# TimescaleDB makes events/audit_log hypertables + a score_timeline continuous aggregate (Tiger Data prize).
# postgres:16-alpine also works: battlefield skips Timescale and logs timescale_unavailable.
POSTGRES_IMAGE=timescale/timescaledb:latest-pg16
# Pause an episode once its summed factory_credits reach this. 0 disables (local default).
MAX_CREDITS_PER_EPISODE=0

# ---- agents (Factory Droid SDK) ----
# Each dev uses their own FACTORY_API_KEY locally (or leaves it empty with DRY_RUN=true).
# The prod key lives only in the GitHub `production` environment, nowhere else.
FACTORY_API_KEY=
DROID_MODEL_RED=
DROID_MODEL_GREEN=
DROID_MODEL_BLUE=
# reasoning effort per agent: none|off|minimal|low|medium|high|xhigh|max (blank = model default)
DROID_REASONING_RED=
DROID_REASONING_GREEN=
DROID_REASONING_BLUE=
DRY_RUN=false
# Per-agent override of DRY_RUN; blank = follow DRY_RUN. E.g. DRY_RUN=false with DRY_RUN_GREEN=true
# and DRY_RUN_BLUE=true runs red live while green and blue stay keyless.
DRY_RUN_RED=
DRY_RUN_GREEN=
DRY_RUN_BLUE=

# ---- blue gate LLM (direct API, fast path) ----
BLUE_GATE_LLM_PROVIDER=gemini
BLUE_GATE_LLM_API_KEY=
BLUE_GATE_LLM_MODEL=

# ---- mock agents only (make mock-agents; ignored by real blue) ----
# Force the stub blue gate to escalate, to exercise the human-in-the-loop path. Comma-separated:
# all | amount>N | action:<gated action> | <mock rule id>. Empty = stub default behavior.
MOCK_BLUE_ESCALATE=

# ---- optional sponsor integrations ----
# Blue-only CRS sandbox login; leave both empty when unused. DRY_RUN makes no CRS calls.
# The identity client uses username/password, not the legacy API key below.
CRS_USERNAME=
CRS_PASSWORD=
# Legacy compatibility only; unused by the CRS identity client.
CRS_API_KEY=
CARTESIA_API_KEY=

# ---- frontend ----
# Server-side only (Next route handlers): where the /api/bf proxy forwards, with OPERATOR_TOKEN.
# Compose sets it to http://battlefield:8000; this value is for `npm run dev` on the host.
BATTLEFIELD_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MOCK=false
# Cloudflare Access JWT check at the origin (frontend middleware). Leave blank locally (check off).
# Prod sets both as GitHub `production` variables; render-env refuses a DOMAIN deploy without them.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
