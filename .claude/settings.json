{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git rebase -i*)",
      "Bash(git commit --amend*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review --approve*)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(make db-reset*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ],
    "allow": [
      "Bash(make lint*)",
      "Bash(make test*)",
      "Bash(uv run pytest*)",
      "Bash(uv sync*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current*)",
      "Bash(git fetch*)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin red/*)",
      "Bash(git push -u origin green/*)",
      "Bash(git push -u origin blue/*)",
      "Bash(git push -u origin frontend/*)",
      "Bash(git push -u origin battlefield/*)",
      "Bash(git push -u origin contracts/*)"
    ]
  }
}
