{
  "name": "redledger-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:live": "node tools/dev-live.mjs",
    "fake:bf": "node tools/fake-battlefield.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
