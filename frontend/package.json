    "gen:api": "openapi-typescript ../contracts/ledger-api.yaml -o lib/api.gen.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "jose": "^6.2.13",
    "next": "^15.5.28",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.8.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "openapi-typescript": "^7",
    "postcss": "^8",
    "prettier": "^3",
