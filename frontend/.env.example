# frontend env. Copy to .env.local for `npm run dev`. Owner: Dev R.
# Never put a token in a NEXT_PUBLIC_ var: anything NEXT_PUBLIC_ can end up in the browser bundle.

# Server-only (Next route handlers under app/api/bf/**), read per request:
BATTLEFIELD_URL=http://localhost:8000
OPERATOR_TOKEN=change-me-operator

# Cloudflare Access JWT check (middleware.ts), server-only, read per request. Both set → every
# request must carry a valid Access JWT (Cf-Access-Jwt-Assertion header or CF_Authorization
# cookie), else 403. Leave blank locally / in CI / with NEXT_PUBLIC_MOCK=true = check disabled.
# Prod: CF_ACCESS_TEAM_DOMAIN=mdracc.cloudflareaccess.com, CF_ACCESS_AUD=<Access app AUD tag>.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Browser-reachable socket base. Served to the client at runtime via /api/bf/ws-ticket (`ws_url`).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# true = replay public/mocks/sample.jsonl with zero backend and zero other env. Build-time switch.
NEXT_PUBLIC_MOCK=false
