# TLS at the edge. One public hostname: app.$DOMAIN (Cloudflare DNS, proxied with SSL "Full
# (strict)" and Cloudflare Access in front once Caddy holds a certificate). Internal traffic stays
# plain HTTP on the compose networks.
#
# Only two things are reachable from the internet, both behind Access:
#   /api/ws  → battlefield (WebSocket; still needs a single-use ticket or the operator token)
#   *        → frontend (its server-side /api/bf/* proxy is the only holder of OPERATOR_TOKEN)
# Battlefield's REST API has no public hostname: agents reach it on the `agents` network and the
# frontend on `edge`. Operators use `make prod-*` (deploy/PROD-OPS.md).
#
# Origin lock: Access is enforced at Cloudflare's edge, so a client that connects to the VM's IP
# directly would skip it (and reach the operator proxy). Only Cloudflare's published ranges
# (https://www.cloudflare.com/ips-v4 and /ips-v6, fetched 2026-10-24) are served; anything else
# gets 403. Refresh this list if Cloudflare changes it. The ACME HTTP-01 challenge on :80 is
# handled by Caddy before site routes, so certificate renewal still works.
(cloudflare_only) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare "forbidden" 403
}

app.{$DOMAIN} {
	import cloudflare_only
	encode gzip
	@ws path /api/ws /api/ws/*
	reverse_proxy @ws battlefield:8000
	reverse_proxy frontend:3000
}
