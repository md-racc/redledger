# TLS at the edge. Public hostnames: app.$DOMAIN, plus red.$DOMAIN and blue.$DOMAIN, the hidden backstage
# doors (frontend/lib/backstage/alias.ts; admin-only, everyone else gets a 404). Cloudflare DNS, proxied with SSL "Full
# (strict)". Internal traffic stays plain HTTP on the compose networks.
#
# Access mode is chosen by deploy/render-env.sh (README §11, §13): either Cloudflare Access in front
# with the origin verifying its JWT (both CF_ACCESS_* set), or public read-only mode (both blank)
# where anyone can watch and only ADMIN_KEY holders can act. Prod runs public read-only since
# 2026-10-25 (Access app kept, with a bypass policy).
#
# Only two things are reachable from the internet:
#   /api/ws  → battlefield (WebSocket; still needs a single-use ticket or the operator token)
#   *        → frontend (its server-side /api/bf/* proxy is the only holder of OPERATOR_TOKEN and
#              refuses every non-GET for viewers; see frontend/AGENTS.md "Viewers and admins")
# Battlefield's REST API has no public hostname: agents reach it on the `agents` network and the
# frontend on `edge`. Operators use `make prod-*` (deploy/PROD-OPS.md).
#
# Origin lock: everything is meant to arrive through Cloudflare's edge (TLS, proxying and, when it
# is on, Access). A client that connects to the VM's IP directly would skip all of that, so only
# Cloudflare's published ranges (https://www.cloudflare.com/ips-v4 and /ips-v6, fetched 2026-10-24)
# are served; anything else gets 403. Refresh this list if Cloudflare changes it. The ACME HTTP-01
# challenge on :80 is handled by Caddy before site routes, so certificate renewal still works.
(cloudflare_only) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cloudflare "forbidden" 403
}

app.{$DOMAIN} {
	import cloudflare_only
	encode gzip
	@ws path /api/ws /api/ws/*
	reverse_proxy @ws battlefield:8000
	reverse_proxy frontend:3000
}

# The hidden doors: the frontend rewrites / to /backstage/<team> on these hosts and serves it only to admins
# (frontend/lib/backstage/gate.ts). WebSockets still go to app.$DOMAIN (NEXT_PUBLIC_WS_URL).
red.{$DOMAIN}, blue.{$DOMAIN} {
	import cloudflare_only
	encode gzip
	reverse_proxy frontend:3000
}
